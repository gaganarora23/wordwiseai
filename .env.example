# Copy to .env (git-ignored) and edit. Placeholders only; never commit real secrets.

# Database user created on first start of the volume.
POSTGRES_USER=wordwise
# Database password. Must not be empty. Changing it after the volume exists does not change the stored password.
POSTGRES_PASSWORD=change-me
# Database created on first start of the volume.
POSTGRES_DB=wordwise
# Host port for PostgreSQL on 127.0.0.1; change it if a local PostgreSQL already uses 5432.
DB_PORT=5432

# SQLAlchemy URL used by the backend (host/port/user/password/db must match the values above).
DATABASE_URL=postgresql+psycopg://wordwise:change-me@localhost:5432/wordwise
# Comma-separated browser origins the backend allows via CORS (frontend dev server).
CORS_ORIGINS=http://localhost:8080
